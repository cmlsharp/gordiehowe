+fn test_tampered_z_rejected() {
+	for json in VECTORS {
+		let vector = load(json);
+		assert_rejected(&vector, "c_tilde", |c, w| {
+			let wire = c.z[0][0];
+			w[wire] = Word(w[wire].as_u64() + 1);
+		});
+		let err = run_with(&vector, ConstMul::ShiftAdd, |c, w| {
+			let wire = c.z[0][0];
+			w[wire] = Word(w[wire].as_u64() + 1);
+		})
+		.unwrap_err();
+		assert!(err.contains("c_tilde"), "{err}");
+	}
+}
+
+#[test]
+fn test_tampered_message_rejected() {
+	let vector = load(VECTORS[0]);
+	// Byte 5 of the message is tail byte 7.
+	assert_rejected(&vector, "c_tilde", |c, w| flip(w, c.mu_tail[0], 8 * 7));
+}
+
+#[test]
+fn test_truncated_message_rejected() {
+	let vector = load(VECTORS[0]);
+	assert_rejected(&vector, "c_tilde", |c, w| {
+		w[c.msg_len] = Word(vector.msg.len() as u64 - 1);
+	});
+}
+
+#[test]
+fn test_overlong_message_rejected() {
+	let vector = load(VECTORS[0]);
+	assert_rejected(&vector, "msg_len", |c, w| w[c.msg_len] = Word(MAX_MSG as u64 + 1));
+}
+
+#[test]
+fn test_tampered_prefix_rejected() {
+	let vector = load(VECTORS[0]);
+	// The |ctx| byte.
+	assert_rejected(&vector, "mu_prefix", |c, w| flip(w, c.mu_tail[0], 8));
+}
+
+#[test]
+fn test_tampered_tr_rejected() {
+	let vector = load(VECTORS[1]);
+	assert_rejected(&vector, "c_tilde", |c, w| flip(w, c.tr[3], 0));
+}
+
+#[test]
+fn test_tampered_c_tilde_rejected() {
+	let vector = load(VECTORS[2]);
+	let err = run(&vector, |c, w| flip(w, c.c_tilde[0], 0)).unwrap_err();
+	assert!(err.contains("c_tilde") || err.contains("sample_in_ball"), "{err}");
+}
+
+#[test]
+#[ignore = "prints circuit statistics"]
+fn print_circuit_stats() {
+	for const_mul in [ConstMul::Imul, ConstMul::ShiftAdd] {
+		for params in [Params::ML_DSA_44, Params::ML_DSA_65, Params::ML_DSA_87] {
+			let mut b = CircuitBuilder::new();
+			MlDsaVerify::new(&mut b, params, MAX_MSG, 0, const_mul);
+			let circuit = b.build();
+			println!("{params:?} {const_mul:?}\n{}", CircuitStat::collect(&circuit));
+		}
+	}
+}
