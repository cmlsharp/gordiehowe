# Writes the compile cache's compiler digest (compiler/compile_cache.h):
# SHA-256 over each source's path relative to ROOT and its SHA-256, in
# sorted order. Run by the gordiehowe_compiler_digest library's custom
# command with ROOT, OUT and SOURCES (a ';'-separated list).
list(SORT SOURCES)
set(ALL "")
foreach(F ${SOURCES})
  file(SHA256 ${F} H)
  file(RELATIVE_PATH R ${ROOT} ${F})
  string(APPEND ALL "${R} ${H}\n")
endforeach()
string(SHA256 DIGEST "${ALL}")
file(WRITE ${OUT}.tmp
     "// Generated by compiler_digest.cmake: the GordieHowe compiler digest.\n"
     "namespace proofs::gordiehowe {\n"
     "extern const char kCompilerDigest[];\n"
     "const char kCompilerDigest[] = \"${DIGEST}\";\n"
     "}  // namespace proofs::gordiehowe\n")
file(RENAME ${OUT}.tmp ${OUT})
