+    /// The masked circuit with `r` the 32-byte private message `msg` and the public
+    /// `H(M, pi_1)` set to zero, so `com = msg`: phase 1 commits `msg` where
+    /// [`Self::compute_commitment_masked`] commits a random `r`. Returns the state
+    /// for [`Self::prove`], with `com = msg` the message the signature is on.
+    pub fn compute_commitment_private_message(
+        &self,
+        msg: &[u8; COMMITMENT_SIZE_BYTES],
+        transcript: &mut Transcript,
+        rng: &mut ThreadRng,
+    ) -> CircuitResult<ProofState> {
+        assert_eq!(self.commitment_type, Masked);
+        let r: Vec<F2> = (0..COMMITMENT_SIZE_BYTES * 8)
+            .map(|i| F2::from((msg[i / 8] >> (i % 8)) & 1 == 1))
+            .collect();
+        let (_, _, prover_state) =
+            with_mldsa_params!(self.version, self.segment_plan, |B, D, F, W, S| {
+                let circuit = BlindMLDSACircuit::<B, D, F, W, S>::new(self.clone());
+                MixedHOProof::<VoleProver, VoleVerifier, VoleProverFq, VoleVerifierFq>::prove_1_with_randomness(
+                    &circuit,
+                    r,
+                    transcript,
+                    rng,
+                    self.edabit_variant,
+                    self.mask_method,
+                )
+            })?;
+        let h_f2 = [F2::ZERO; COMMITMENT_SIZE_BYTES * 8];
+        Ok(MaskedCommitmentState(ProofState1NoHashCom { h_f2, prover_state }))
+    }
