@@ -0,0 +1,102 @@
+// Copyright 2026 The Binius Developers
+//! ML-DSA verification: knowledge of a message and a signature on it that verifies under a
+//! public key. See [`binius_circuits::ml_dsa`].
+
+use anyhow::{Result, bail};
+use binius_circuits::ml_dsa::{ConstMul, MlDsaVerify, Params as MlDsaParams};
+use binius_frontend::{CircuitBuilder, WitnessFiller};
+use clap::Args;
+use serde::Deserialize;
+
+pub struct MlDsaExample {
+	circuit: MlDsaVerify,
+	vector: Vector,
+}
+
+#[derive(Args, Debug, Clone)]
+pub struct Params {
+	/// ML-DSA parameter set: 44, 65 or 87
+	#[arg(long, default_value_t = 44)]
+	pub param_set: u16,
+	/// Maximum message length in bytes (the message length itself is private)
+	#[arg(long, default_value_t = 32)]
+	pub max_msg_bytes: usize,
+	/// Constrain products by constants with shifts and additions instead of IMUL constraints
+	#[arg(long)]
+	pub shift_add: bool,
+}
+
+#[derive(Args, Debug, Clone)]
+pub struct Instance {}
+
+/// A signature on a message, with the public key's derived values, produced by `dilithium-py`;
+/// see the circuit's testdata.
+#[derive(Deserialize)]
+pub struct Vector {
+	pub a_hat: Vec<Vec<Vec<u64>>>,
+	pub t1_hat: Vec<Vec<u64>>,
+	pub tr: Vec<u8>,
+	pub ctx: Vec<u8>,
+	pub msg: Vec<u8>,
+	pub c_tilde: Vec<u8>,
+	pub z: Vec<Vec<u64>>,
+	pub h: Vec<Vec<u64>>,
+}
+
+/// The parameter set and the bundled vector for `param_set`.
+pub fn vector(param_set: u16) -> Result<(MlDsaParams, Vector)> {
+	let (params, json) = match param_set {
+		44 => (
+			MlDsaParams::ML_DSA_44,
+			include_str!("../../../circuits/src/ml_dsa/testdata/ml_dsa_44.json"),
+		),
+		65 => (
+			MlDsaParams::ML_DSA_65,
+			include_str!("../../../circuits/src/ml_dsa/testdata/ml_dsa_65.json"),
+		),
+		87 => (
+			MlDsaParams::ML_DSA_87,
+			include_str!("../../../circuits/src/ml_dsa/testdata/ml_dsa_87.json"),
+		),
+		_ => bail!("unknown ML-DSA parameter set {param_set}; expected 44, 65 or 87"),
+	};
+	Ok((params, serde_json::from_str(json)?))
+}
+
+impl crate::ExampleCircuit for MlDsaExample {
+	type Params = Params;
+	type Instance = Instance;
+
+	fn build(params: Params, builder: &mut CircuitBuilder) -> Result<Self> {
+		let (ml_dsa_params, vector) = vector(params.param_set)?;
+		if vector.msg.len() > params.max_msg_bytes {
+			bail!("the bundled message has {} bytes", vector.msg.len());
+		}
+		let const_mul = if params.shift_add {
+			ConstMul::ShiftAdd
+		} else {
+			ConstMul::Imul
+		};
+		let circuit = MlDsaVerify::new(
+			builder,
+			ml_dsa_params,
+			params.max_msg_bytes,
+			vector.ctx.len(),
+			const_mul,
+		);
+		Ok(Self { circuit, vector })
+	}
+
+	fn populate_witness(&self, _instance: Instance, w: &mut WitnessFiller<'_>) -> Result<()> {
+		let v = &self.vector;
+		self.circuit
+			.populate_public(w, &v.a_hat, &v.t1_hat, &v.tr, &v.ctx);
+		self.circuit
+			.populate_private(w, &v.ctx, &v.msg, &v.c_tilde, &v.z, &v.h);
+		Ok(())
+	}
+
+	fn param_summary(params: &Params) -> Option<String> {
+		Some(format!("mldsa{}", params.param_set))
+	}
+}
