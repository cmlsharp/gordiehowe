import GordieHowe.Language.Completeness.Check
import GordieHoweCerts.Generated.MLDSA44.Native.ROMParams.Cert
import GordieHoweCerts.Generated.MLDSA44.Native.ROMParams.Structure

/-!
# Tests of the lookup checks at the structure records' pointers

On MLDSA44 Native, ROM parameters (bound values 57, 64 and 65, the records of lookups 11, 12 and
13):

* the bound values' check (`boundRecsVE`) accepts the exported `boundRecs` and refuses a pointer to
  another lookup (`notBoundRec`) and a missing entry (`noRecord`);
* the lookups' check (`digitLookupCE`) accepts the exported generators and refuses a lookup whose
  first digit is claimed as a quotient digit's (`commLookup`) or generated as no lookup digit
  (`lookupFacts`).
-/

namespace GordieHoweTest.StructureLookups

open GordieHowe GordieHowe.RealizedProgram GordieHowe.Twin
open GordieHowe.Generated.MLDSA44.Native.ROMParams

/-- The failure a twin reports, if any. -/
def failOf : Except StructFailure Unit → Option StructFailure
  | .ok _ => none
  | .error f => some f

/-- The first failure of a check over the values, visiting them in order. -/
def firstFail (f : ℕ → Value → Except StructFailure Unit) : List Value → ℕ → Option StructFailure
  | [], _ => none
  | x :: xs, i =>
    match f i x with
    | .error e => some e
    | .ok _ => firstFail f xs (i + 1)

/-- The program. -/
abbrev ir : RealizedProgram := Program.program

/-- The generators, as the table the value pass reads. -/
abbrev GT : NatTrie Gen := toTrie Cert.gens

/-- The bound values' check over the values, at the entries `l`. -/
def boundFail (l : List (ℕ × ℕ)) : Option StructFailure :=
  firstFail (ir.boundRecsVE GT (NatTrie.ofList l)) ir.values 0

/-- The exported entries, as printed. -/
example : Structure.records.boundRecs = [(57, 11), (64, 12), (65, 13)] := by decide +kernel

/-- The exported entries are accepted. -/
example : boundFail Structure.records.boundRecs = none := by decide +kernel

/-- The verdict is the twin's. -/
example (v : ℕ) (x : Value) :
    ir.boundRecsV GT Structure.records.boundRecTab v x =
      okB (ir.boundRecsVE GT Structure.records.boundRecTab v x) := rfl

/-- Value 57 pointed at lookup 12 (value 64's): refused, naming the value and the lookup. -/
example : boundFail [(57, 12), (64, 12), (65, 13)] = some ⟨57, 12, .notBoundRec⟩ := by
  decide +kernel

/-- Value 64's entry removed: refused, naming the value. -/
example : boundFail [(57, 11), (65, 13)] = some ⟨64, 0, .noRecord⟩ := by decide +kernel

/-- The first digit of lookup `q`. -/
def firstDigit (q : ℕ) : ℕ :=
  match lookupOf? (ir.predicate q).body with
  | some r => r.digitValues.headD 0
  | none => 0

/-- The exported generators with lookup 11's first digit generated by `x`. -/
def gensWith (x : Gen) : Gens := Cert.gens.set (firstDigit 11) x

/-- Lookup 11 checks at the exported generators. -/
example : failOf (ir.digitLookupCE Cert.gens 11) = none := by decide +kernel

/-- The verdict is the twin's. -/
example (G : Gens) (q : ℕ) : ir.digitLookupCB G q = okB (ir.digitLookupCE G q) := rfl

/-- Lookup 11's first digit claimed as a quotient digit of predicate 0: refused (`commLookup`). -/
example : failOf (ir.digitLookupCE (gensWith (.commDigit 0 0 11 0)) 11) =
    some ⟨11, 0, .commLookup⟩ := by decide +kernel

/-- Lookup 11's first digit generated as no lookup digit: refused (`lookupFacts`). -/
example : failOf (ir.digitLookupCE (gensWith .none) 11) = some ⟨11, 0, .lookupFacts⟩ := by
  decide +kernel

end GordieHoweTest.StructureLookups
