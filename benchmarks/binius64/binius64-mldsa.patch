+// Copyright 2026 The Binius Developers
+//! Tests against vectors produced by `dilithium-py` from real ML-DSA signatures on a 32-byte
+//! message under the empty context; see `testdata/`.
+
+use binius_core::word::Word;
+use binius_frontend::{CircuitBuilder, CircuitStat, WitnessFiller};
+use serde_json::Value;
+
+use super::*;
+
+struct Vector {
+	params: Params,
+	a_hat: Vec<Vec<Vec<u64>>>,
+	t1_hat: Vec<Vec<u64>>,
+	tr: Vec<u8>,
+	ctx: Vec<u8>,
+	msg: Vec<u8>,
+	c_tilde: Vec<u8>,
+	c: Vec<u64>,
+	z: Vec<Vec<u64>>,
+	h: Vec<Vec<u64>>,
+}
+
+fn load(json: &str) -> Vector {
+	fn get<T: serde::de::DeserializeOwned>(v: &Value, key: &str) -> T {
+		serde_json::from_value(v[key].clone()).unwrap()
+	}
+	let v: Value = serde_json::from_str(json).unwrap();
+	let params = match v["name"].as_str().unwrap() {
+		"ml_dsa_44" => Params::ML_DSA_44,
+		"ml_dsa_65" => Params::ML_DSA_65,
+		"ml_dsa_87" => Params::ML_DSA_87,
+		name => panic!("unknown parameter set {name}"),
+	};
+	assert_eq!(params.k as u64, v["k"].as_u64().unwrap());
+	assert_eq!(params.tau as u64, v["tau"].as_u64().unwrap());
+	assert_eq!(params.gamma2, v["gamma2"].as_u64().unwrap());
+	Vector {
+		params,
+		a_hat: get(&v, "a_hat"),
+		t1_hat: get(&v, "t1_hat"),
+		tr: get(&v, "tr"),
+		ctx: get(&v, "ctx"),
+		msg: get(&v, "msg"),
+		c_tilde: get(&v, "c_tilde"),
+		c: get(&v, "c"),
+		z: get(&v, "z"),
+		h: get(&v, "h"),
+	}
+}
+
+const VECTORS: [&str; 3] = [
+	include_str!("testdata/ml_dsa_44.json"),
+	include_str!("testdata/ml_dsa_65.json"),
+	include_str!("testdata/ml_dsa_87.json"),
+];
+
+/// The maximum message length of the circuits under test.
+const MAX_MSG: usize = 32;
+
+/// Builds the circuit and populates it with `vector` after applying `tamper`.
+fn run(
+	vector: &Vector,
+	tamper: impl FnOnce(&MlDsaVerify, &mut WitnessFiller<'_>),
+) -> Result<(), String> {
+	run_with(vector, ConstMul::Imul, tamper)
+}
+
+fn run_with(
+	vector: &Vector,
+	const_mul: ConstMul,
+	tamper: impl FnOnce(&MlDsaVerify, &mut WitnessFiller<'_>),
+) -> Result<(), String> {
+	let mut b = CircuitBuilder::new();
+	let circuit_def = MlDsaVerify::new(&mut b, vector.params, MAX_MSG, vector.ctx.len(), const_mul);
+	let circuit = b.build();
+	let mut w = circuit.new_witness_filler();
+	circuit_def.populate_public(&mut w, &vector.a_hat, &vector.t1_hat, &vector.tr, &vector.ctx);
+	circuit_def.populate_private(
+		&mut w,
+		&vector.ctx,
+		&vector.msg,
+		&vector.c_tilde,
+		&vector.z,
+		&vector.h,
+	);
+	tamper(&circuit_def, &mut w);
+	circuit
+		.populate_wire_witness(&mut w)
+		.map_err(|e| format!("{e:?}"))
+}
+
+/// Asserts that `tamper` makes population fail with an assertion named `name`.
+fn assert_rejected(
+	vector: &Vector,
+	name: &str,
+	tamper: impl FnOnce(&MlDsaVerify, &mut WitnessFiller<'_>),
+) {
+	let err = run(vector, tamper).expect_err("tampered witness must not satisfy the circuit");
+	assert!(err.contains(name), "expected {name}, got {err}");
+}
+
+fn flip(w: &mut WitnessFiller<'_>, wire: Wire, bit: u32) {
+	w[wire] = Word(w[wire].as_u64() ^ 1 << bit);
+}
+
+#[test]
+fn test_reference_constants() {
+	// ζ has order 512 and 256 · 256⁻¹ = 1 (FIPS 204).
+	assert_eq!(mod_pow(ZETA, 256), Q - 1);
+	assert_eq!(256 * mod_pow(256, Q - 2) % Q, 1);
+}
+
+#[test]
+fn test_vectors_accept() {
+	for const_mul in [ConstMul::Imul, ConstMul::ShiftAdd] {
+		for json in VECTORS {
+			let vector = load(json);
+			run_with(&vector, const_mul, |_, _| {}).unwrap_or_else(|e| {
+				panic!("{:?} {const_mul:?}: valid signature rejected: {e}", vector.params)
+			});
+		}
+	}
+}
+
+#[test]
+fn test_naf() {
+	for c in [
+		1u64,
+		2,
+		3,
+		7,
+		1753,
+		Q,
+		Q - 1,
+		8347681,
+		190464,
+		u64::from(u32::MAX),
+	] {
+		let (pos, neg) = naf(c);
+		let value: i128 = pos.iter().map(|&i| 1i128 << i).sum::<i128>()
+			- neg.iter().map(|&i| 1i128 << i).sum::<i128>();
+		assert_eq!(value, i128::from(c));
+		let mut all: Vec<u32> = pos.iter().chain(&neg).copied().collect();
+		all.sort();
+		assert!(all.windows(2).all(|w| w[1] > w[0] + 1), "{c}: adjacent nonzero digits");
+	}
+}
+
+#[test]
+fn test_sample_in_ball_matches_reference() {
+	for json in VECTORS {
+		let vector = load(json);
+		let b = CircuitBuilder::new();
+		let c_tilde = witnesses(&b, vector.params.c_tilde_bytes / 8);
+		let stream =
+			shake256(&b, &c_tilde, vector.params.c_tilde_bytes, sample_in_ball::STREAM_BYTES);
+		let c = sample_in_ball::sample_in_ball(&b, &stream, vector.params.tau);
+		for &wire in c.support.iter().chain(&c.sign) {
+			b.mark_inout(wire);
+		}
+		let circuit = b.build();
+		let mut w = circuit.new_witness_filler();
+		populate_bytes(&mut w, &c_tilde, &vector.c_tilde);
+		circuit.populate_wire_witness(&mut w).unwrap();
+		let bit = |words: &[Wire; 4], i: usize| (w[words[i / 64]].as_u64() >> (i % 64)) & 1;
+		for (i, &ci) in vector.c.iter().enumerate() {
+			let expected = match ci {
+				0 => (0, 0),
+				1 => (1, 0),
+				ci if ci == Q - 1 => (1, 1),
+				ci => panic!("non-ternary challenge coefficient {ci}"),
+			};
+			assert_eq!(
+				(bit(&c.support, i), bit(&c.sign, i)),
+				expected,
+				"{:?}: c[{i}]",
+				vector.params
+			);
+		}
+	}
+}
+
+#[test]
+fn test_z_norm_violation_rejected() {
+	let vector = load(VECTORS[0]);
+	// Offset encoding of z = γ1 − β, one past the bound.
+	assert_rejected(&vector, "z_norm", |c, w| {
+		w[c.z[0][7]] = Word(2 * vector.params.z_bound() - 1);
+	});
+}
+
+#[test]
+fn test_hint_weight_rejected() {
+	let vector = load(VECTORS[0]);
+	assert_rejected(&vector, "hint_weight", |c, w| {
+		for &wire in c.h.iter().flatten().take(2) {
+			w[wire] = Word(u64::MAX);
+		}
+	});
+}
