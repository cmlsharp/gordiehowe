+// Copyright 2026 The Binius Developers
+//! ML-DSA (FIPS 204) verification.
+//!
+//! [`MlDsaVerify`] proves knowledge of a message `M` and a signature `(c̃, z, h)` that verify under
+//! a public key, FIPS 204 Algorithm 8:
+//!
+//! ```text
+//! μ = H(tr ‖ 0x00 ‖ |ctx| ‖ ctx ‖ M, 64),   c = SampleInBall(c̃),
+//! ‖z‖∞ < γ1 − β,   ‖h‖₁ ≤ ω,
+//! w1 = UseHint(h, NTT⁻¹(Â ∘ NTT(z) − NTT(c) ∘ t̂)),   c̃ = H(μ ‖ w1Encode(w1), λ/4)
+//! ```
+//!
+//! The public key enters through the values a verifier derives from it outside the circuit:
+//! `Â = ExpandA(ρ)`, `t̂ = NTT(t1 · 2^d)` and `tr = H(pk, 64)`. The context is public; the
+//! message, its length (up to a maximum) and the signature are private.
+//!
+//! # Arithmetic modulo q
+//!
+//! `q = 8380417 < 2^23`, so a field element fits in one 64-bit word and a product of two fits
+//! in the low word of an `imul`. Reduction uses the same nondeterministic idiom as
+//! [`PseudoMersennePrimeField`](crate::bignum::PseudoMersennePrimeField): the prover supplies
+//! `(quotient, remainder)` through [`BigUintDivideHint`], and the circuit checks
+//! `quotient · q + remainder = v` without wraparound and `remainder < q`.
+//!
+//! Sums are reduced lazily: only products are reduced, and every intermediate carries a
+//! build-time upper bound ([`Lazy`]) which is asserted to stay far below `2^64`. Subtraction
+//! adds a multiple of `q` that covers the subtrahend's bound, so values stay non-negative.
+//! The bounds hold for every satisfying witness, because the only free values (private inputs
+//! and hint outputs) are range-checked.
+//!
+//! Public inputs `Â` and `t̂` are assumed canonical (`< q`); the verifier derives them.
+
+use binius_core::word::Word;
+use binius_frontend::{CircuitBuilder, Wire, WitnessFiller};
+
+use crate::{
+	bignum::BigUintDivideHint,
+	fixed_byte_vec::ByteVec,
+	popcount::popcount,
+	sha3::shake::{shake256, shake256_varlen},
+};
+
+pub mod sample_in_ball;
+#[cfg(test)]
+mod tests;
+
+/// The ML-DSA modulus `q = 2^23 − 2^13 + 1`.
+pub const Q: u64 = 8_380_417;
+/// Polynomial degree.
+pub const N: usize = 256;
+/// Primitive 512-th root of unity modulo `q`.
+const ZETA: u64 = 1753;
+/// Length of `tr = H(pk, 64)` in bytes.
+pub const TR_BYTES: usize = 64;
+/// Length of `μ` in bytes.
+pub const MU_BYTES: usize = 64;
+/// Bound below which every lazily reduced intermediate must stay.
+const LAZY_LIMIT: u128 = 1 << 63;
+
+/// How a product by a constant is constrained: the NTT twiddles, `256⁻¹`, `quotient · q` in each
+/// reduction, and `2γ2` in Decompose.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum ConstMul {
+	/// One IMUL constraint per product.
+	#[default]
+	Imul,
+	/// Free shifts and additions over the constant's non-adjacent form: AND constraints only.
+	ShiftAdd,
+}
+
+/// Non-adjacent form of `c`: the positions of its `+1` and of its `−1` digits.
+fn naf(c: u64) -> (Vec<u32>, Vec<u32>) {
+	let (mut pos, mut neg) = (Vec::new(), Vec::new());
+	let mut c = u128::from(c);
+	let mut i = 0;
+	while c != 0 {
+		if c & 1 == 1 {
+			if c & 3 == 1 {
+				pos.push(i);
+				c -= 1;
+			} else {
+				neg.push(i);
+				c += 1;
+			}
+		}
+		c >>= 1;
+		i += 1;
+	}
+	(pos, neg)
+}
+
+/// `x · c` for `x < x_bound`, by shifts and additions; returns the product and its bound.
+///
+/// Every partial sum stays below `(x_bound − 1) · Σ 2^{+1 positions} < 2^63`, asserted at build
+/// time, so no addition wraps.
+fn mul_const_shift_add(b: &CircuitBuilder, x: Wire, x_bound: u128, c: u64) -> (Wire, u128) {
+	assert!(c > 0);
+	let (pos, neg) = naf(c);
+	let positive: u128 = pos.iter().map(|&i| 1u128 << i).sum();
+	assert!((x_bound - 1) * positive < LAZY_LIMIT, "shift-add product may exceed 2^63");
+	let sum = |positions: &[u32]| {
+		positions
+			.iter()
+			.map(|&i| b.shl(x, i))
+			.reduce(|acc, term| b.iadd(acc, term).0)
+	};
+	let plus = sum(&pos).expect("c > 0 has a +1 digit");
+	let product = match sum(&neg) {
+		Some(minus) => b.isub_bin_bout(plus, minus, b.add_constant(Word::ZERO)).0,
+		None => plus,
+	};
+	(product, (x_bound - 1) * u128::from(c) + 1)
+}
+
+/// ML-DSA parameter set (FIPS 204, Table 1), restricted to what verification uses.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Params {
+	pub k: usize,
+	pub l: usize,
+	pub gamma1: u64,
+	pub gamma2: u64,
+	pub beta: u64,
+	pub omega: u64,
+	/// Nonzero coefficients of the challenge.
+	pub tau: usize,
+	/// Length of `c̃` in bytes, `λ/4`.
+	pub c_tilde_bytes: usize,
+}
+
+impl Params {
+	pub const ML_DSA_44: Self = Self {
+		k: 4,
+		l: 4,
+		gamma1: 1 << 17,
+		gamma2: (Q - 1) / 88,
+		beta: 78,
+		omega: 80,
+		tau: 39,
+		c_tilde_bytes: 32,
+	};
+	pub const ML_DSA_65: Self = Self {
+		k: 6,
+		l: 5,
+		gamma1: 1 << 19,
+		gamma2: (Q - 1) / 32,
+		beta: 196,
+		omega: 55,
+		tau: 49,
+		c_tilde_bytes: 48,
+	};
+	pub const ML_DSA_87: Self = Self {
+		k: 8,
+		l: 7,
+		gamma1: 1 << 19,
+		gamma2: (Q - 1) / 32,
+		beta: 120,
+		omega: 75,
+		tau: 60,
+		c_tilde_bytes: 64,
+	};
+
+	/// The ∞-norm bound `γ1 − β` on `z`.
+	pub const fn z_bound(&self) -> u64 {
+		self.gamma1 - self.beta
+	}
+
+	/// Number of high-bits values, `(q − 1) / (2γ2)`.
+	pub const fn m(&self) -> u64 {
+		(Q - 1) / (2 * self.gamma2)
+	}
+
+	/// Bits per `w1` coefficient in `w1Encode`, `bitlen(m − 1)`.
+	pub const fn w1_bits(&self) -> u32 {
+		64 - (self.m() - 1).leading_zeros()
+	}
+
+	/// Length of `w1_tilde = w1Encode(w1)` in 64-bit words.
+	pub const fn w1_tilde_words(&self) -> usize {
+		self.k * N * self.w1_bits() as usize / 64
+	}
+}
+
+/// A wire holding an integer in `[0, bound)` that is congruent to the intended value mod `q`.
+#[derive(Clone, Copy)]
+struct Lazy {
+	wire: Wire,
+	bound: u128,
+}
+
+impl Lazy {
+	fn new(wire: Wire, bound: u128) -> Self {
+		assert!(bound <= LAZY_LIMIT, "lazy bound {bound} exceeds 2^63");
+		Self { wire, bound }
+	}
+}
+
+/// Modular arithmetic on single-word values for the fixed modulus `q`.
+struct ModQ<'a> {
+	b: &'a CircuitBuilder,
+	q: Wire,
+	zero: Wire,
+	const_mul: ConstMul,
+}
+
+impl<'a> ModQ<'a> {
+	fn new(b: &'a CircuitBuilder, const_mul: ConstMul) -> Self {
+		Self {
+			b,
+			q: b.add_constant_64(Q),
+			zero: b.add_constant(Word::ZERO),
+			const_mul,
+		}
+	}
+
+	/// Canonical residue of `v` modulo `q`.
+	///
+	/// Cost: `quotient · q` (see [`ConstMul`]), plus AND constraints for the addition, the
+	/// range check and the assertions.
+	fn reduce(&self, v: Lazy) -> Lazy {
+		let b = self.b;
+		let (quotient, remainder) = BigUintDivideHint::call(b, &[v.wire], &[self.q]);
+		let (quotient, remainder) = (quotient[0], remainder[0]);
+
+		// quotient · q + remainder = v, with neither the product nor the sum wrapping.
+		let product = match self.const_mul {
+			ConstMul::Imul => {
+				let (hi, lo) = b.imul(quotient, self.q);
+				b.assert_zero("mod_q_reduce_hi", hi);
+				lo
+			}
+			ConstMul::ShiftAdd => {
+				// The honest quotient is at most (v.bound − 1) / q; bounding it by the next power
+				// of two keeps quotient · q below 2^63.
+				let quotient_bits = 128 - ((v.bound - 1) / Q as u128).leading_zeros();
+				b.assert_zero("mod_q_reduce_quotient", b.shr(quotient, quotient_bits));
+				mul_const_shift_add(b, quotient, 1 << quotient_bits, Q).0
+			}
+		};
+		let (sum, carry) = b.iadd(product, remainder);
+		b.assert_false("mod_q_reduce_carry", carry);
+		b.assert_eq("mod_q_reduce", sum, v.wire);
+		b.assert_true("mod_q_reduce_range", b.icmp_ult(remainder, self.q));
+
+		Lazy::new(remainder, Q as u128)
+	}
+
+	fn add(&self, x: Lazy, y: Lazy) -> Lazy {
+		let (sum, _carry) = self.b.iadd(x.wire, y.wire);
+		Lazy::new(sum, x.bound + y.bound)
+	}
+
+	/// `x − y + M·q` for the least `M` with `M·q ≥ y.bound`.
+	fn sub(&self, x: Lazy, y: Lazy) -> Lazy {
+		let offset = y.bound.div_ceil(Q as u128) * Q as u128;
+		let (shifted, _carry) = self.b.iadd(x.wire, self.b.add_constant_64(offset as u64));
+		let (diff, _borrow) = self.b.isub_bin_bout(shifted, y.wire, self.zero);
+		Lazy::new(diff, x.bound + offset)
+	}
+
+	/// Unreduced product of two lazy values.
+	fn mul(&self, x: Lazy, y: Lazy) -> Lazy {
+		let (_hi, lo) = self.b.imul(x.wire, y.wire);
+		Lazy::new(lo, (x.bound - 1) * (y.bound - 1) + 1)
+	}
+
+	/// Reduced product of a lazy value and a constant in `[0, q)`.
+	fn mul_const(&self, x: Lazy, c: u64) -> Lazy {
+		let product = match self.const_mul {
+			ConstMul::Imul => self.mul(x, Lazy::new(self.b.add_constant_64(c), Q as u128)),
+			ConstMul::ShiftAdd => {
+				let (wire, bound) = mul_const_shift_add(self.b, x.wire, x.bound, c);
+				Lazy::new(wire, bound)
+			}
+		};
+		self.reduce(product)
+	}
+
+	/// Forward NTT (FIPS 204, Algorithm 41), output in bit-reversed order, unreduced.
+	fn ntt(&self, mut w: Vec<Lazy>) -> Vec<Lazy> {
+		let zetas = zetas();
+		let mut m = 0;
+		let mut len = N / 2;
+		while len >= 1 {
+			for start in (0..N).step_by(2 * len) {
+				m += 1;
+				for j in start..start + len {
+					let t = self.mul_const(w[j + len], zetas[m]);
+					w[j + len] = self.sub(w[j], t);
+					w[j] = self.add(w[j], t);
+				}
+			}
+			len /= 2;
+		}
+		w
+	}
+
+	/// Inverse NTT (FIPS 204, Algorithm 42), output canonical.
+	fn intt(&self, mut w: Vec<Lazy>) -> Vec<Lazy> {
+		let zetas = zetas();
+		let mut m = N;
+		let mut len = 1;
+		while len < N {
+			for start in (0..N).step_by(2 * len) {
+				m -= 1;
+				for j in start..start + len {
+					let t = w[j];
+					w[j] = self.add(t, w[j + len]);
+					let diff = self.sub(t, w[j + len]);
+					w[j + len] = self.mul_const(diff, Q - zetas[m]);
+				}
+			}
+			len *= 2;
+		}
+		// Scale by 256^{-1}; this also brings every coefficient to canonical form.
+		let n_inv = mod_pow(N as u64, Q - 2);
+		w.into_iter().map(|x| self.mul_const(x, n_inv)).collect()
+	}
+}
+
+/// `ζ^{brv8(i)} mod q` for `i ∈ [0, 256)`.
+fn zetas() -> Vec<u64> {
+	(0..N)
+		.map(|i| mod_pow(ZETA, (i as u8).reverse_bits() as u64))
+		.collect()
+}
+
+fn mod_pow(base: u64, mut exp: u64) -> u64 {
+	let (mut acc, mut base) = (1u64, base % Q);
+	while exp > 0 {
+		if exp & 1 == 1 {
+			acc = acc * base % Q;
+		}
+		base = base * base % Q;
+		exp >>= 1;
+	}
+	acc
+}
+
+/// Circuit for ML-DSA verification. See the [module docs](self).
+pub struct MlDsaVerify {
+	pub params: Params,
+	/// Maximum message length in bytes.
+	pub max_msg_bytes: usize,
+	/// Public `Â[r][s]` in NTT domain, `k × l × N` canonical coefficients.
+	pub a_hat: Vec<Vec<Vec<Wire>>>,
+	/// Public `t̂[r] = NTT(t1[r] · 2^d)`, `k × N` canonical coefficients.
+	pub t1_hat: Vec<Vec<Wire>>,
+	/// Public `tr = H(pk, 64)`, little-endian words.
+	pub tr: Vec<Wire>,
+	/// Public context string, little-endian words (its length is the circuit's).
+	pub ctx: Vec<Wire>,
+	/// Private `μ` input after `tr`: `0x00 ‖ |ctx| ‖ ctx ‖ M ‖ 0…`, little-endian words.
+	pub mu_tail: Vec<Wire>,
+	/// Private message length in bytes, at most `max_msg_bytes`.
+	pub msg_len: Wire,
+	/// Private `c̃`, little-endian words.
+	pub c_tilde: Vec<Wire>,
+	/// Private `z[s]`, `l × N` coefficients, each holding `z + (γ1 − β − 1)` for centered `z`.
+	pub z: Vec<Vec<Wire>>,
+	/// Private hint `h[r]`, `k × N/64` words, bit `i` of word `j` is coefficient `64j + i`.
+	pub h: Vec<Vec<Wire>>,
+}
+
+impl MlDsaVerify {
+	/// The circuit for messages of at most `max_msg_bytes` bytes under contexts of `ctx_bytes`
+	/// bytes, with products by constants constrained as `const_mul` says.
+	pub fn new(
+		b: &mut CircuitBuilder,
+		params: Params,
+		max_msg_bytes: usize,
+		ctx_bytes: usize,
+		const_mul: ConstMul,
+	) -> Self {
+		assert!(ctx_bytes <= 255, "FIPS 204 contexts are at most 255 bytes");
+		let Params { k, l, .. } = params;
+		let a_hat: Vec<Vec<Vec<Wire>>> = (0..k)
+			.map(|_| (0..l).map(|_| inouts(b, N)).collect())
+			.collect();
+		let t1_hat: Vec<Vec<Wire>> = (0..k).map(|_| inouts(b, N)).collect();
+		let tr = inouts(b, TR_BYTES / 8);
+		let ctx = inouts(b, ctx_bytes.div_ceil(8));
+		let prefix_bytes = 2 + ctx_bytes;
+		let mu_tail = witnesses(b, (prefix_bytes + max_msg_bytes).div_ceil(8));
+		let msg_len = b.add_witness();
+		let c_tilde = witnesses(b, params.c_tilde_bytes / 8);
+		let z: Vec<Vec<Wire>> = (0..l).map(|_| witnesses(b, N)).collect();
+		let h: Vec<Vec<Wire>> = (0..k).map(|_| witnesses(b, N / 64)).collect();
+
+		// μ = H(tr ‖ 0x00 ‖ |ctx| ‖ ctx ‖ M, 64), for a message of private length.
+		let mu = {
+			// The tail's prefix bytes are the public 0x00, |ctx| and ctx.
+			for (j, &word) in mu_tail.iter().enumerate().take(prefix_bytes.div_ceil(8)) {
+				let mut expected =
+					b.add_constant_64(if j == 0 { (ctx_bytes as u64) << 8 } else { 0 });
+				// ctx byte i sits at tail byte 2 + i.
+				if j < ctx.len() {
+					expected = b.bxor(expected, b.shl(ctx[j], 16));
+				}
+				if j >= 1 && j - 1 < ctx.len() {
+					expected = b.bxor(expected, b.shr(ctx[j - 1], 48));
+				}
+				let n = (prefix_bytes - 8 * j).min(8);
+				let byte_mask =
+					b.add_constant_64(if n == 8 { u64::MAX } else { (1 << (8 * n)) - 1 });
+				b.assert_eq(
+					format!("mu_prefix[{j}]"),
+					b.band(word, byte_mask),
+					b.band(expected, byte_mask),
+				);
+			}
+			let max = b.add_constant_64(max_msg_bytes as u64);
+			b.assert_true("msg_len", b.icmp_ule(msg_len, max));
+			let len = b
+				.iadd(msg_len, b.add_constant_64((TR_BYTES + prefix_bytes) as u64))
+				.0;
+			let input = ByteVec::new_with_len_range(
+				tr.iter().chain(&mu_tail).copied().collect(),
+				len,
+				TR_BYTES + prefix_bytes..=TR_BYTES + prefix_bytes + max_msg_bytes,
+			);
+			shake256_varlen(b, &input, MU_BYTES)
+		};
+
+		// c = SampleInBall(c̃).
+		let challenge = {
+			let stream = shake256(b, &c_tilde, params.c_tilde_bytes, sample_in_ball::STREAM_BYTES);
+			sample_in_ball::sample_in_ball(b, &stream, params.tau)
+		};
+
+		// ‖h‖_1 ≤ ω.
+		let mut weight = b.add_constant(Word::ZERO);
+		for &word in h.iter().flatten() {
+			let count = popcount(b, word);
+			weight = b.iadd(weight, count).0;
+		}
+		let omega = b.add_constant_64(params.omega);
+		b.assert_true("hint_weight", b.icmp_ule(weight, omega));
+
+		let w1 = {
+			let f = ModQ::new(b, const_mul);
+
+			// ‖z‖∞ < γ1 − β: the offset encoding lies in [0, 2(γ1 − β) − 1).
+			let z_off = params.z_bound() - 1;
+			let z_range = b.add_constant_64(2 * params.z_bound() - 1);
+			let z_hat: Vec<Vec<Lazy>> = z
+				.iter()
+				.map(|poly| {
+					let coeffs = poly
+						.iter()
+						.map(|&wire| {
+							b.assert_true("z_norm", b.icmp_ult(wire, z_range));
+							offset_input(&f, wire, 2 * params.z_bound() - 1, z_off)
+						})
+						.collect();
+					f.ntt(coeffs)
+				})
+				.collect();
+
+			// c_k ∈ {0, 1, q − 1} from the masks: q − 1 = 1 ⊕ q since q is odd.
+			let one = b.add_constant_64(1);
+			let q = b.add_constant_64(Q);
+			let c_hat = f.ntt(
+				(0..N)
+					.map(|i| {
+						let bit = |words: &[Wire; 4]| {
+							b.sar(b.shl(words[i / 64], 63 - (i % 64) as u32), 63)
+						};
+						let unit = b.bxor(one, b.band(q, bit(&challenge.sign)));
+						Lazy::new(b.band(unit, bit(&challenge.support)), Q as u128)
+					})
+					.collect(),
+			);
+
+			(0..k)
+				.flat_map(|r| {
+					// Â[r] ∘ ẑ − ĉ ∘ t̂[r], one reduction per coefficient.
+					let w_hat = (0..N)
+						.map(|i| {
+							let canonical = |wire| Lazy::new(wire, Q as u128);
+							let az = (0..l)
+								.map(|s| f.mul(canonical(a_hat[r][s][i]), z_hat[s][i]))
+								.reduce(|x, y| f.add(x, y))
+								.expect("l > 0");
+							let ct = f.mul(c_hat[i], canonical(t1_hat[r][i]));
+							f.reduce(f.sub(az, ct))
+						})
+						.collect();
+					let w_approx = f.intt(w_hat);
+
+					w_approx
+						.iter()
+						.enumerate()
+						.map(|(i, r_i)| {
+							let hint_bit = b.shl(h[r][i / 64], 63 - (i % 64) as u32);
+							use_hint(b, &params, const_mul, hint_bit, r_i.wire)
+						})
+						.collect::<Vec<_>>()
+				})
+				.collect::<Vec<_>>()
+		};
+
+		// c̃ = H(μ ‖ w1Encode(w1), λ/4).
+		let w1_tilde = w1_encode(b, &w1, params.w1_bits());
+		let input: Vec<Wire> = mu.iter().chain(&w1_tilde).copied().collect();
+		let recomputed = shake256(b, &input, MU_BYTES + 8 * w1_tilde.len(), params.c_tilde_bytes);
+		for (j, (&x, &y)) in recomputed.iter().zip(&c_tilde).enumerate() {
+			b.assert_eq(format!("c_tilde[{j}]"), x, y);
+		}
+
+		Self {
+			params,
+			max_msg_bytes,
+			a_hat,
+			t1_hat,
+			tr,
+			ctx,
+			mu_tail,
+			msg_len,
+			c_tilde,
+			z,
+			h,
+		}
+	}
+
+	/// Assign the public key's derived values (`Â` and `t̂` as canonical coefficients mod `q`,
+	/// `tr`) and the context.
+	pub fn populate_public(
+		&self,
+		w: &mut WitnessFiller<'_>,
+		a_hat: &[Vec<Vec<u64>>],
+		t1_hat: &[Vec<u64>],
+		tr: &[u8],
+		ctx: &[u8],
+	) {
+		for (wires, vals) in self.a_hat.iter().flatten().zip(a_hat.iter().flatten()) {
+			populate(w, wires, vals);
+		}
+		for (wires, vals) in self.t1_hat.iter().zip(t1_hat) {
+			populate(w, wires, vals);
+		}
+		assert_eq!(tr.len(), TR_BYTES);
+		populate_bytes(w, &self.tr, tr);
+		assert!(ctx.len() <= 8 * self.ctx.len());
+		populate_bytes(w, &self.ctx, ctx);
+	}
+
+	/// Assign the private message and signature: `c̃` as bytes, `z` and `h` as canonical
+	/// coefficients mod `q`.
+	pub fn populate_private(
+		&self,
+		w: &mut WitnessFiller<'_>,
+		ctx: &[u8],
+		msg: &[u8],
+		c_tilde: &[u8],
+		z: &[Vec<u64>],
+		h: &[Vec<u64>],
+	) {
+		assert!(msg.len() <= self.max_msg_bytes, "message longer than the circuit's maximum");
+		let mut tail = vec![0u8, ctx.len() as u8];
+		tail.extend_from_slice(ctx);
+		tail.extend_from_slice(msg);
+		populate_bytes(w, &self.mu_tail, &tail);
+		w[self.msg_len] = Word(msg.len() as u64);
+
+		assert_eq!(c_tilde.len(), self.params.c_tilde_bytes);
+		populate_bytes(w, &self.c_tilde, c_tilde);
+		let z_off = self.params.z_bound() - 1;
+		for (wires, vals) in self.z.iter().zip(z) {
+			let shifted: Vec<u64> = vals.iter().map(|&v| (v + z_off) % Q).collect();
+			populate(w, wires, &shifted);
+		}
+		for (wires, bits) in self.h.iter().zip(h) {
+			for (j, &wire) in wires.iter().enumerate() {
+				let word = (0..64).fold(0u64, |acc, i| acc | (bits[64 * j + i] & 1) << i);
+				w[wire] = Word(word);
+			}
+		}
+	}
+}
+
+/// Assign `bytes`, zero-padded, to `wires` as little-endian words.
+fn populate_bytes(w: &mut WitnessFiller<'_>, wires: &[Wire], bytes: &[u8]) {
+	assert!(bytes.len() <= 8 * wires.len());
+	for (j, &wire) in wires.iter().enumerate() {
+		let mut word = [0u8; 8];
+		for (i, byte) in word.iter_mut().enumerate() {
+			*byte = bytes.get(8 * j + i).copied().unwrap_or(0);
+		}
+		w[wire] = Word(u64::from_le_bytes(word));
+	}
+}
+
+/// `w1Encode` (FIPS 204, Algorithm 28): `bits`-bit coefficients packed little-endian, as
+/// 64-bit words. Each coefficient must already be below `2^bits`.
+fn w1_encode(b: &CircuitBuilder, w1: &[Wire], bits: u32) -> Vec<Wire> {
+	let bits = bits as usize;
+	(0..w1.len() * bits / 64)
+		.map(|j| {
+			let (lo, hi) = (64 * j, 64 * (j + 1));
+			let parts: Vec<Wire> = w1
+				.iter()
+				.enumerate()
+				.filter(|&(i, _)| bits * i < hi && bits * (i + 1) > lo)
+				.map(|(i, &x)| {
+					let start = bits * i;
+					if start >= lo {
+						b.shl(x, (start - lo) as u32)
+					} else {
+						b.shr(x, (lo - start) as u32)
+					}
+				})
+				.collect();
+			b.bxor_multi(&parts)
+		})
+		.collect()
+}
+
+/// Turn an offset-encoded input `x + offset ∈ [0, range)` into a lazy value `≡ x (mod q)`.
+fn offset_input(f: &ModQ<'_>, wire: Wire, range: u64, offset: u64) -> Lazy {
+	f.sub(
+		Lazy::new(wire, range as u128),
+		Lazy::new(f.b.add_constant_64(offset), offset as u128 + 1),
+	)
+}
+
+/// `UseHint(h, r)` for canonical `r` (FIPS 204, Algorithms 36 and 40).
+///
+/// `hint_bit` carries the hint in its MSB.
+fn use_hint(
+	b: &CircuitBuilder,
+	params: &Params,
+	const_mul: ConstMul,
+	hint_bit: Wire,
+	r: Wire,
+) -> Wire {
+	let gamma2 = params.gamma2;
+	let m = params.m();
+
+	// Decompose: r + γ2 − 1 = r1' · 2γ2 + r0', with r0' = r0 + γ2 − 1 ∈ [0, 2γ2), i.e. the
+	// centered low part r0 ∈ (−γ2, γ2]. Since r < q, r1' ≤ m, with r1' = m exactly in the
+	// wraparound case r − r0 = q − 1.
+	let two_gamma2 = b.add_constant_64(2 * gamma2);
+	let shifted = b.iadd(r, b.add_constant_64(gamma2 - 1)).0;
+	let (r1, r0) = BigUintDivideHint::call(b, &[shifted], &[two_gamma2]);
+	let (r1, r0) = (r1[0], r0[0]);
+	b.assert_true("decompose_r1_range", b.icmp_ule(r1, b.add_constant_64(m)));
+	b.assert_true("decompose_r0_range", b.icmp_ult(r0, two_gamma2));
+	// r1 ≤ m, so the product stays far below 2^64.
+	let prod = match const_mul {
+		ConstMul::Imul => b.imul(r1, two_gamma2).1,
+		ConstMul::ShiftAdd => mul_const_shift_add(b, r1, u128::from(m) + 1, 2 * gamma2).0,
+	};
+	b.assert_eq("decompose", b.iadd(prod, r0).0, shifted);
+
+	let zero = b.add_constant(Word::ZERO);
+	let m_minus_1 = b.add_constant_64(m - 1);
+	let r1 = b.select(b.icmp_eq(r1, b.add_constant_64(m)), zero, r1);
+	// r0 > 0. In the wraparound case r0 ≤ 0 already, so no adjustment is needed.
+	let r0_positive = b.icmp_uge(r0, b.add_constant_64(gamma2));
+
+	let one = b.add_constant_64(1);
+	let up = b.select(b.icmp_eq(r1, m_minus_1), zero, b.iadd(r1, one).0);
+	let down = b.select(b.icmp_eq(r1, zero), m_minus_1, b.isub_bin_bout(r1, one, zero).0);
+	let adjusted = b.select(r0_positive, up, down);
+	b.select(hint_bit, adjusted, r1)
+}
+
+fn inouts(b: &CircuitBuilder, n: usize) -> Vec<Wire> {
+	(0..n).map(|_| b.add_inout()).collect()
+}
+
+fn witnesses(b: &CircuitBuilder, n: usize) -> Vec<Wire> {
+	(0..n).map(|_| b.add_witness()).collect()
+}
+
+fn populate(w: &mut WitnessFiller<'_>, wires: &[Wire], vals: &[u64]) {
+	assert_eq!(wires.len(), vals.len());
+	for (&wire, &v) in wires.iter().zip(vals) {
+		w[wire] = Word(v);
+	}
+}
diff --git i/crates/circuits/src/ml_dsa/sample_in_ball.rs w/crates/circuits/src/ml_dsa/sample_in_ball.rs
new file mode 100644
index 0000000..1bc431e
--- /dev/null
+++ w/crates/circuits/src/ml_dsa/sample_in_ball.rs
@@ -0,0 +1,164 @@
+// Copyright 2026 The Binius Developers
+//! SampleInBall (FIPS 204, Algorithm 29) on a fixed-length SHAKE256 stream.
+//!
+//! The stream's first 8 bytes are the sign bits; the rest are candidates for the rejection
+//! sampling. Step `s ∈ [0, τ)` targets `i = 256 − τ + s` and takes the next candidate `j ≤ i`,
+//! then sets `c_i ← c_j` and `c_j ← (−1)^sign_s`.
+//!
+//! The prover supplies the accepted candidates `j_0, …, j_{τ−1}` through [`SampleInBallHint`].
+//! One pass over the candidates checks them: a candidate is accepted iff fewer than `τ` are
+//! accepted before it and it is at most `256 − τ + (number accepted before it)`, and each
+//! accepted candidate must equal the next hinted value, read off a shift register. Exactly `τ`
+//! must be accepted. The swaps then run on two 256-bit masks, support (`c_k ≠ 0`) and sign
+//! (`c_k = −1`), each `j` decoded to a one-hot mask.
+
+use binius_core::word::Word;
+use binius_frontend::{CircuitBuilder, Wire, hints::Hint};
+
+/// Bytes of the SHAKE256 stream read: 8 sign bytes and 264 candidates. FIPS 204, Appendix C,
+/// bounds the candidates a signer needs by 221 bytes except with negligible probability; this
+/// is the Longfellow fork's budget too.
+pub const STREAM_BYTES: usize = 272;
+
+const SIGN_BYTES: usize = 8;
+
+/// The challenge `c` as masks over the coefficient indices, bit `k % 64` of word `k / 64`.
+pub struct Challenge {
+	/// `c_k ≠ 0`.
+	pub support: [Wire; 4],
+	/// `c_k = −1`.
+	pub sign: [Wire; 4],
+}
+
+/// The accepted candidates of a stream, packed eight per word, little-endian.
+pub struct SampleInBallHint;
+
+impl Hint for SampleInBallHint {
+	const NAME: &'static str = "binius.ml_dsa.sample_in_ball";
+
+	fn shape(&self, dimensions: &[usize]) -> (usize, usize) {
+		let [tau] = dimensions else {
+			panic!("SampleInBallHint takes [tau]");
+		};
+		(STREAM_BYTES / 8, tau.div_ceil(8))
+	}
+
+	fn execute(&self, dimensions: &[usize], inputs: &[Word], outputs: &mut [Word]) {
+		let tau = dimensions[0];
+		let bytes: Vec<u8> = inputs
+			.iter()
+			.flat_map(|w| w.as_u64().to_le_bytes())
+			.collect();
+		outputs.fill(Word::ZERO);
+		let mut count = 0;
+		for &byte in &bytes[SIGN_BYTES..] {
+			if count < tau && usize::from(byte) <= 256 - tau + count {
+				outputs[count / 8] =
+					Word(outputs[count / 8].as_u64() | u64::from(byte) << (8 * (count % 8)));
+				count += 1;
+			}
+		}
+	}
+}
+
+/// All-ones if the MSB of `x` is set, else zero.
+fn mask(b: &CircuitBuilder, x: Wire) -> Wire {
+	b.sar(x, 63)
+}
+
+/// The one-hot 256-bit mask of the byte `j`.
+fn one_hot(b: &CircuitBuilder, j: Wire) -> [Wire; 4] {
+	// Positions k < 64 whose bit `bit` is set.
+	const PATTERNS: [u64; 6] = [
+		0xAAAA_AAAA_AAAA_AAAA,
+		0xCCCC_CCCC_CCCC_CCCC,
+		0xF0F0_F0F0_F0F0_F0F0,
+		0xFF00_FF00_FF00_FF00,
+		0xFFFF_0000_FFFF_0000,
+		0xFFFF_FFFF_0000_0000,
+	];
+	let mut low = b.add_constant_64(u64::MAX);
+	for (bit, pattern) in PATTERNS.into_iter().enumerate() {
+		// pattern if bit `bit` of j is set, its complement otherwise.
+		let bit_mask = mask(b, b.shl(j, 63 - bit as u32));
+		low = b.band(low, b.bxor(b.add_constant_64(!pattern), bit_mask));
+	}
+	let word = b.shr(j, 6);
+	std::array::from_fn(|w| b.band(low, mask(b, b.icmp_eq(word, b.add_constant_64(w as u64)))))
+}
+
+/// Whether `x & y` is nonzero, as an MSB-bool.
+fn intersects(b: &CircuitBuilder, x: &[Wire; 4], y: &[Wire; 4]) -> Wire {
+	let any = (0..4)
+		.map(|w| b.band(x[w], y[w]))
+		.reduce(|p, q| b.bor(p, q))
+		.expect("four words");
+	b.icmp_ne(any, b.add_constant(Word::ZERO))
+}
+
+/// SampleInBall with `tau` nonzero coefficients from the first [`STREAM_BYTES`] bytes of the
+/// SHAKE256 stream `stream`, as little-endian words.
+pub fn sample_in_ball(b: &CircuitBuilder, stream: &[Wire], tau: usize) -> Challenge {
+	assert_eq!(stream.len(), STREAM_BYTES / 8);
+	assert!(0 < tau && tau <= 64, "the sign bits are one word");
+	let zero = b.add_constant(Word::ZERO);
+
+	let accepted = b.call_hint(SampleInBallHint, &[tau], stream);
+
+	// The rejection sampling: the accepted candidates, in order, are the hinted ones.
+	let tau_wire = b.add_constant_64(tau as u64);
+	let first_target = b.add_constant_64((256 - tau) as u64);
+	let byte_mask = b.add_constant_64(0xFF);
+	let mut register = accepted.clone();
+	let mut count = zero;
+	for t in SIGN_BYTES..STREAM_BYTES {
+		let candidate = b.extract_byte(stream[t / 8], (t % 8) as u32);
+		let target = b.iadd(first_target, count).0;
+		let accept = b.band(b.icmp_ult(count, tau_wire), b.icmp_ule(candidate, target));
+		b.assert_eq_cond(
+			"sample_in_ball_candidate",
+			candidate,
+			b.band(register[0], byte_mask),
+			accept,
+		);
+		let n = register.len();
+		register = (0..n)
+			.map(|i| {
+				let shifted = if i + 1 < n {
+					b.bxor(b.shr(register[i], 8), b.shl(register[i + 1], 56))
+				} else {
+					b.shr(register[i], 8)
+				};
+				b.select(accept, shifted, register[i])
+			})
+			.collect();
+		count = b.iadd(count, b.shr(accept, 63)).0;
+	}
+	b.assert_eq("sample_in_ball_count", count, tau_wire);
+
+	// The swaps: c_i ← c_j, then c_j ← (−1)^sign_s.
+	let signs = stream[0];
+	let mut support = [zero; 4];
+	let mut sign = [zero; 4];
+	for s in 0..tau {
+		let i = 256 - tau + s;
+		let j = one_hot(b, b.extract_byte(accepted[s / 8], (s % 8) as u32));
+		let read_support = mask(b, intersects(b, &support, &j));
+		let read_sign = mask(b, intersects(b, &sign, &j));
+		let sign_s = mask(b, b.shl(signs, 63 - s as u32));
+		for w in 0..4 {
+			let not_j = b.bnot(j[w]);
+			let mut new_support = b.bor(support[w], j[w]);
+			let mut new_sign = b.bor(b.band(sign[w], not_j), b.band(j[w], sign_s));
+			if w == i / 64 {
+				// Cell i is zero before step s. If j = i, c_j's write wins.
+				let i_bit = b.add_constant_64(1 << (i % 64));
+				new_support = b.bor(new_support, b.band(i_bit, read_support));
+				new_sign = b.bor(new_sign, b.band(b.band(i_bit, not_j), read_sign));
+			}
+			support[w] = new_support;
+			sign[w] = new_sign;
+		}
+	}
+	Challenge { support, sign }
+}
