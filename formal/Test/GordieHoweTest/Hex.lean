/-
New file: not from VCVio. Small hex/byte helpers shared by the ML-DSA vector-checking
files under `Test/GordieHoweTest/`, so that the generated data files (`Test/GordieHoweTest/Data/*.lean`)
can hold plain hex `String` and `Array Nat` literals instead of exploded `ByteArray`/`Vector`
literals.
-/
import LatticeCrypto.MLDSA.ConcretePrimitives

namespace GordieHoweTest

open MLDSA

/-- Decode one ASCII hex digit; `0` on anything else (callers only ever pass vetted
lowercase-hex strings generated by `Test/scripts/gen_vectors.py`). -/
private def hexNibble (c : Char) : UInt8 :=
  if '0' ≤ c ∧ c ≤ '9' then (c.toNat - '0'.toNat).toUInt8
  else if 'a' ≤ c ∧ c ≤ 'f' then (c.toNat - 'a'.toNat + 10).toUInt8
  else if 'A' ≤ c ∧ c ≤ 'F' then (c.toNat - 'A'.toNat + 10).toUInt8
  else 0

/-- Parse a lowercase-hex string (even length) into a `ByteArray`, most-significant
nibble first within each byte. -/
def hexToBytes (s : String) : ByteArray :=
  let chars := s.toList.toArray
  let n := chars.size / 2
  ByteArray.mk (Array.ofFn fun i : Fin n =>
    (hexNibble chars[2 * i.val]! <<< 4) ||| hexNibble chars[2 * i.val + 1]!)

/-- Parse a lowercase-hex string into a `List Byte`, for arguments (such as `fipsVerify`'s
`msg`) that want a byte list rather than a `ByteArray`. -/
def hexToByteList (s : String) : List Byte :=
  MLDSA.Concrete.byteArrayToList (hexToBytes s)

/-- Build an `Rq` value from its 256 coefficients, given as natural numbers already
reduced mod `q` (as the C++ reference test vectors are). -/
def rqOfNats (vals : Array Nat) : Rq :=
  MLDSA.polyKernel.ofArray (vals.map fun n : Nat => (n : Coeff))

/-- Build a `Tq` (NTT-domain) value from its 256 coefficients, given as natural numbers
already reduced mod `q`. -/
def tqOfNats (vals : Array Nat) : Tq :=
  ⟨rqOfNats vals⟩

/-- FIPS 204's message preprocessing, `M' = 0x00 ‖ IntegerToBytes(|ctx|, 1) ‖ ctx ‖ msg`
(the outer `ML-DSA.Verify`, Algorithm 3, before calling the internal `ML-DSA.Verify_internal`,
Algorithm 8). The vendored `MLDSA.fipsVerify` implements Algorithm 8 directly: its `msg`
argument is Algorithm 8's `M'`, already preprocessed, so callers holding a raw message and
context must apply this first. Requires `ctx.length ≤ 255`, as FIPS 204 does. -/
def preprocessMessage (msg ctx : List Byte) : List Byte :=
  (0 : Byte) :: UInt8.ofNat ctx.length :: (ctx ++ msg)

end GordieHoweTest
