+// Copyright 2026 The Binius Developers
+//! FIPS 202 SHAKE256, the extendable-output function over the SHA3-256 sponge.
+//!
+//! SHAKE256 absorbs exactly like SHA3-256, at the same 136-byte rate, with the four-bit domain
+//! suffix `1111` in place of SHA-3's `01`: for a byte-aligned message the first padding byte is
+//! `0x1F`. Output longer than one rate block is squeezed with a further permutation per block.
+
+use binius_frontend::{CircuitBuilder, Wire};
+
+use super::{SHA3_256_RATE_BYTES, fixed_length::sha3_fixed, varlen::sha3_varlen};
+use crate::{
+	fixed_byte_vec::ByteVec,
+	keccak::{N_WORDS_PER_STATE, permutation::keccak_f1600},
+};
+
+/// The SHAKE domain suffix folded into the first padding byte.
+const SHAKE_DELIMITER_BYTE: u64 = 0x1F;
+
+/// Rate of SHAKE256, in bytes.
+pub const SHAKE256_RATE_BYTES: usize = SHA3_256_RATE_BYTES;
+
+/// Reads `out_bytes` bytes of output from an absorbed sponge state, as little-endian words.
+fn squeeze(
+	builder: &CircuitBuilder,
+	mut state: [Wire; N_WORDS_PER_STATE],
+	out_bytes: usize,
+) -> Vec<Wire> {
+	let rate_words = SHAKE256_RATE_BYTES / 8;
+	let out_words = out_bytes.div_ceil(8);
+	let mut out = Vec::with_capacity(out_words);
+	loop {
+		let take = rate_words.min(out_words - out.len());
+		out.extend_from_slice(&state[..take]);
+		if out.len() == out_words {
+			return out;
+		}
+		keccak_f1600(builder, &mut state);
+	}
+}
+
+/// SHAKE256 of a fixed-length message.
+///
+/// `message` holds `len_bytes.div_ceil(8)` little-endian words; the bytes of the last word past
+/// `len_bytes` are ignored. Returns `out_bytes.div_ceil(8)` little-endian words; the bytes of the
+/// last word past `out_bytes` are further output, which the caller may ignore.
+pub fn shake256(
+	builder: &CircuitBuilder,
+	message: &[Wire],
+	len_bytes: usize,
+	out_bytes: usize,
+) -> Vec<Wire> {
+	let state = sha3_fixed(builder, message, len_bytes, SHAKE256_RATE_BYTES, SHAKE_DELIMITER_BYTE);
+	squeeze(builder, state, out_bytes)
+}
+
+/// SHAKE256 of a variable-length message, bounded by the capacity of `message`.
+///
+/// Returns `out_bytes.div_ceil(8)` little-endian words, as [`shake256`].
+pub fn shake256_varlen(builder: &CircuitBuilder, message: &ByteVec, out_bytes: usize) -> Vec<Wire> {
+	let state = sha3_varlen(builder, message, SHAKE256_RATE_BYTES, SHAKE_DELIMITER_BYTE);
+	squeeze(builder, state, out_bytes)
+}
+
+#[cfg(test)]
+mod tests {
+	use binius_core::Word;
+	use rand::prelude::*;
+	use rstest::rstest;
+
+	use super::*;
+	use crate::keccak::permutation::ref_keccak_f1600;
+
+	/// SHAKE256 on the native Keccak-f[1600].
+	fn reference(message: &[u8], out_bytes: usize) -> Vec<u8> {
+		let rate = SHAKE256_RATE_BYTES;
+		let mut padded = message.to_vec();
+		padded.push(SHAKE_DELIMITER_BYTE as u8);
+		padded.resize(padded.len().div_ceil(rate) * rate, 0);
+		*padded.last_mut().unwrap() |= 0x80;
+
+		let mut state = [0u64; 25];
+		for block in padded.chunks(rate) {
+			for (lane, bytes) in state.iter_mut().zip(block.chunks(8)) {
+				*lane ^= u64::from_le_bytes(bytes.try_into().unwrap());
+			}
+			ref_keccak_f1600(&mut state);
+		}
+		let mut out = Vec::with_capacity(out_bytes);
+		loop {
+			for lane in &state[..rate / 8] {
+				out.extend_from_slice(&lane.to_le_bytes());
+			}
+			if out.len() >= out_bytes {
+				out.truncate(out_bytes);
+				return out;
+			}
+			ref_keccak_f1600(&mut state);
+		}
+	}
+
+	#[test]
+	fn test_reference_known_answer() {
+		// FIPS 202 SHAKE256 of the empty message, first 32 bytes.
+		assert_eq!(
+			reference(&[], 32),
+			hex_literal::hex!("46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762f")
+		);
+	}
+
+	fn words_to_bytes(words: &[Word], len: usize) -> Vec<u8> {
+		words
+			.iter()
+			.flat_map(|w| w.as_u64().to_le_bytes())
+			.take(len)
+			.collect()
+	}
+
+	#[rstest]
+	#[case(0, 32)]
+	#[case(32, 272)]
+	#[case(98, 64)]
+	#[case(135, 64)]
+	#[case(136, 64)]
+	#[case(832, 32)]
+	#[case(200, 300)]
+	fn test_shake256_fixed(#[case] len: usize, #[case] out_bytes: usize) {
+		let mut rng = StdRng::seed_from_u64(len as u64);
+		let mut message = vec![0u8; len];
+		rng.fill_bytes(&mut message);
+
+		let builder = CircuitBuilder::new();
+		let inputs: Vec<Wire> = (0..len.div_ceil(8)).map(|_| builder.add_inout()).collect();
+		let out = shake256(&builder, &inputs, len, out_bytes);
+		for &wire in &out {
+			builder.mark_inout(wire);
+		}
+		let circuit = builder.build();
+		let mut w = circuit.new_witness_filler();
+		for (&wire, chunk) in inputs.iter().zip(message.chunks(8)) {
+			let mut word = [0u8; 8];
+			word[..chunk.len()].copy_from_slice(chunk);
+			w[wire] = Word(u64::from_le_bytes(word));
+		}
+		circuit.populate_wire_witness(&mut w).unwrap();
+		let got: Vec<Word> = out.iter().map(|&wire| w[wire]).collect();
+		assert_eq!(words_to_bytes(&got, out_bytes), reference(&message, out_bytes));
+	}
+
+	#[rstest]
+	#[case(0)]
+	#[case(1)]
+	#[case(66)]
+	#[case(98)]
+	#[case(135)]
+	#[case(136)]
+	#[case(200)]
+	fn test_shake256_varlen(#[case] len: usize) {
+		let max_len: usize = 200;
+		let out_bytes = 64;
+		let mut rng = StdRng::seed_from_u64(len as u64);
+		let mut message = vec![0u8; len];
+		rng.fill_bytes(&mut message);
+
+		let builder = CircuitBuilder::new();
+		let input = ByteVec::new_inout(&builder, max_len.div_ceil(8));
+		let out = shake256_varlen(&builder, &input, out_bytes);
+		for &wire in &out {
+			builder.mark_inout(wire);
+		}
+		let circuit = builder.build();
+		let mut w = circuit.new_witness_filler();
+		input.populate_len_bytes(&mut w, len);
+		input.populate_bytes_le(&mut w, &message);
+		circuit.populate_wire_witness(&mut w).unwrap();
+		let got: Vec<Word> = out.iter().map(|&wire| w[wire]).collect();
+		assert_eq!(words_to_bytes(&got, out_bytes), reference(&message, out_bytes));
+	}
+}
