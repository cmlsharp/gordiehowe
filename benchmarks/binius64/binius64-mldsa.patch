diff --git i/crates/examples/benches/ml_dsa.rs w/crates/examples/benches/ml_dsa.rs
new file mode 100644
index 0000000..5cb128d
--- /dev/null
+++ w/crates/examples/benches/ml_dsa.rs
@@ -0,0 +1,215 @@
+// Copyright 2026 The Binius Developers
+//! ML-DSA verification core: prover time, verifier time and proof size.
+//!
+//! Metric definitions follow the Longfellow baselines' harness, so the numbers are comparable:
+//!
+//! - prover: commit + prove, from a populated witness to the finished proof (witness generation
+//!   and circuit construction excluded, reported separately);
+//! - verify: the verifier's own setup (`Verifier::setup` from the constraint system) plus
+//!   verification; `verify_only` excludes the setup;
+//! - proof bytes: the transcript the verifier reads.
+//!
+//! Prover setup (key collection from the constraint system, NTT domain, buffer pool) is
+//! per-circuit preprocessing and is reported separately. The first, cold proof is reported too,
+//! since it also fills the buffer pool; warm-up trials are otherwise unrecorded.
+//!
+//! Run single-threaded and pinned, as the Longfellow harness does:
+//!
+//! ```text
+//! RAYON_NUM_THREADS=1 RUSTFLAGS="-C target-cpu=native" taskset -c 2 \
+//!     cargo bench -p binius-examples --bench ml_dsa
+//! ```
+//!
+//! Environment: `MLDSA_PARAM_SETS` (default `44`), `LOG_INV_RATES` (default `1,2`), `MODES`
+//! (`zk,plain`), `HASH` (`sha256` or `blake3`, the Merkle hash suite), `CONST_MUL` (`imul` or `shift-add`), `TRIALS` (9), `WARMUP` (1, at least
+//! 1: the cold proof).
+
+use std::{env, time::Instant};
+
+use binius_core::constraint_system::{ConstraintSystem, ValueVec};
+use binius_examples::{
+	ExampleCircuit, check_proof, check_proof_zk, circuits::ml_dsa, create_proof, create_proof_zk,
+	setup, setup_verifier, setup_zk, setup_zk_verifier,
+};
+use binius_frontend::{CircuitBuilder, CircuitStat};
+use binius_hash::{blake3::Blake3HashSuite, sha256::Sha256HashSuite};
+use binius_hash_prover::ParallelHashSuite;
+use binius_utils::{DeserializeBytes, SerializeBytes};
+use digest::Output;
+
+fn env_list<T: std::str::FromStr>(name: &str, default: &str) -> Vec<T> {
+	env::var(name)
+		.unwrap_or_else(|_| default.to_string())
+		.split(',')
+		.map(|s| {
+			s.trim()
+				.parse()
+				.ok()
+				.unwrap_or_else(|| panic!("bad {name}"))
+		})
+		.collect()
+}
+
+fn env_usize(name: &str, default: usize) -> usize {
+	env::var(name).map_or(default, |s| s.parse().expect(name))
+}
+
+fn ms(start: Instant) -> f64 {
+	start.elapsed().as_secs_f64() * 1e3
+}
+
+/// `median (min-max)` of a sample, in ms.
+fn summary(xs: &mut [f64]) -> (f64, f64, f64) {
+	xs.sort_by(f64::total_cmp);
+	(xs[xs.len() / 2], xs[0], xs[xs.len() - 1])
+}
+
+struct Trial {
+	prove: f64,
+	verify: f64,
+	verify_only: f64,
+	bytes: usize,
+}
+
+/// A closure running one proof and its verification with the hash suite `H`.
+fn runner<'a, H>(
+	cs: &ConstraintSystem,
+	rate: usize,
+	mode: &str,
+	witness: &'a ValueVec,
+) -> Box<dyn FnMut() -> Trial + 'a>
+where
+	H: ParallelHashSuite + Clone + 'a,
+	Output<H::LeafHash>: SerializeBytes + DeserializeBytes,
+{
+	match mode {
+		"zk" => {
+			let (_, prover) = setup_zk::<H>(cs.clone(), rate).expect("setup");
+			let cs = cs.clone();
+			Box::new(move || {
+				let t = Instant::now();
+				let proof = create_proof_zk(&prover, witness, None).expect("prove");
+				let prove = ms(t);
+				let bytes = proof.len();
+				let t = Instant::now();
+				let verifier = setup_zk_verifier::<H>(cs.clone(), rate).expect("setup");
+				let t_only = Instant::now();
+				check_proof_zk(&verifier, witness, proof, None).expect("verify");
+				Trial {
+					prove,
+					verify: ms(t),
+					verify_only: ms(t_only),
+					bytes,
+				}
+			})
+		}
+		"plain" => {
+			let (_, prover) = setup::<H>(cs.clone(), rate, None).expect("setup");
+			let cs = cs.clone();
+			Box::new(move || {
+				let t = Instant::now();
+				let proof = create_proof(&prover, witness).expect("prove");
+				let prove = ms(t);
+				let bytes = proof.len();
+				let t = Instant::now();
+				let verifier = setup_verifier::<H>(cs.clone(), rate).expect("setup");
+				let t_only = Instant::now();
+				check_proof(&verifier, witness, proof).expect("verify");
+				Trial {
+					prove,
+					verify: ms(t),
+					verify_only: ms(t_only),
+					bytes,
+				}
+			})
+		}
+		other => panic!("unknown mode {other}"),
+	}
+}
+
+fn main() {
+	let param_sets: Vec<u16> = env_list("MLDSA_PARAM_SETS", "44");
+	let rates: Vec<usize> = env_list("LOG_INV_RATES", "1,2");
+	let modes: Vec<String> = env_list("MODES", "zk,plain");
+	let trials = env_usize("TRIALS", 9);
+	let warmup = env_usize("WARMUP", 1);
+	let hash = env::var("HASH").unwrap_or_else(|_| "sha256".into());
+	let shift_add = match env::var("CONST_MUL").as_deref() {
+		Ok("imul") | Err(_) => false,
+		Ok("shift-add") => true,
+		Ok(other) => panic!("unknown CONST_MUL {other}"),
+	};
+
+	println!(
+		"# threads={} trials={trials} warmup={warmup} hash={hash} shift_add={shift_add}",
+		env::var("RAYON_NUM_THREADS").unwrap_or_else(|_| "default".into())
+	);
+	println!(
+		"param_set\tmode\tlog_inv_rate\tprover_ms\tverify_ms\tverify_only_ms\tproof_bytes\t\
+		 cold_prover_ms\twitness_ms\tprover_setup_ms\tand\timul\tbmul\tcommitted"
+	);
+
+	for &param_set in &param_sets {
+		let t = Instant::now();
+		let mut builder = CircuitBuilder::new();
+		let example = ml_dsa::MlDsaExample::build(
+			ml_dsa::Params {
+				param_set,
+				max_msg_bytes: 32,
+				shift_add,
+			},
+			&mut builder,
+		)
+		.expect("build");
+		let circuit = builder.build();
+		let build_ms = ms(t);
+		let stat = CircuitStat::collect(&circuit);
+		let cs = circuit.constraint_system().clone();
+
+		let t = Instant::now();
+		let mut filler = circuit.new_witness_filler();
+		example
+			.populate_witness(ml_dsa::Instance {}, &mut filler)
+			.expect("populate");
+		circuit.populate_wire_witness(&mut filler).expect("witness");
+		let witness: ValueVec = filler.into_value_vec();
+		let witness_ms = ms(t);
+		eprintln!("ML-DSA-{param_set}: circuit build {build_ms:.1} ms, witness {witness_ms:.1} ms");
+
+		for &rate in &rates {
+			for mode in &modes {
+				let t = Instant::now();
+				let mut run = match hash.as_str() {
+					"sha256" => runner::<Sha256HashSuite>(&cs, rate, mode, &witness),
+					"blake3" => runner::<Blake3HashSuite>(&cs, rate, mode, &witness),
+					other => panic!("unknown hash suite {other}"),
+				};
+				let setup_ms = ms(t);
+
+				// The first proof also fills the prover's buffer pool: what a one-shot prover pays.
+				let cold = run().prove;
+				for _ in 1..warmup {
+					run();
+				}
+				let results: Vec<Trial> = (0..trials).map(|_| run()).collect();
+				let mut prove: Vec<f64> = results.iter().map(|r| r.prove).collect();
+				let mut verify: Vec<f64> = results.iter().map(|r| r.verify).collect();
+				let mut verify_only: Vec<f64> = results.iter().map(|r| r.verify_only).collect();
+				let bytes = results[0].bytes;
+				assert!(results.iter().all(|r| r.bytes == bytes), "proof size varies");
+
+				let fmt = |(med, lo, hi): (f64, f64, f64)| format!("{med:.1} ({lo:.1}-{hi:.1})");
+				println!(
+					"{param_set}\t{mode}\t{rate}\t{}\t{}\t{}\t{bytes}\t{cold:.1}\t{witness_ms:.1}\t{setup_ms:.1}\t{}\t{}\t{}\t{}",
+					fmt(summary(&mut prove)),
+					fmt(summary(&mut verify)),
+					fmt(summary(&mut verify_only)),
+					stat.n_and_constraints,
+					stat.n_imul_constraints,
+					stat.n_bmul_constraints,
+					stat.committed_allocated,
+				);
+			}
+		}
+	}
+}
