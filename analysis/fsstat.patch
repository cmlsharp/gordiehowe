+// FSSTAT (measurement only, analysis/fsstat.patch): with
+// GH_FSSTAT=PREFIX set, every challenge point appends one line to
+// PREFIX.<pid> when it closes (or its transcript is destroyed):
+//   FSSTAT id=<transcript> k=<k> budget=<k + e> extra=<grant> read=<bytes>
+//          threads=<GH_THREADS> calls=<bytes>:<reads>,...
+// the reads of each length at the point; id numbers the transcripts a
+// process starts (a clone or a fork keeps its parent's). Nothing enters the
+// transcript.
+inline size_t fsstat_next_id() {
+  static std::atomic<size_t> next{0};
+  return ++next;
+}
+struct FsStat {
+  std::map<size_t, size_t> calls;
+  size_t id = 0, k = 0, budget = 0, extra = 0, read = 0;
+  bool open = false;
+  FsStat() = default;
+  FsStat(FsStat &&o) noexcept
+      : calls(std::move(o.calls)), id(o.id), k(o.k), budget(o.budget),
+        extra(o.extra),
+        read(o.read), open(o.open) {
+    o.open = false;
+  }
+  FsStat &operator=(FsStat &&o) noexcept {
+    dump();
+    calls = std::move(o.calls);
+    id = o.id;
+    k = o.k;
+    budget = o.budget;
+    extra = o.extra;
+    read = o.read;
+    open = o.open;
+    o.open = false;
+    return *this;
+  }
+  FsStat(const FsStat &) = delete;
+  FsStat &operator=(const FsStat &) = delete;
+  ~FsStat() { dump(); }
+  void dump() {
+    if (!open) return;
+    open = false;
+    const char *pre = std::getenv("GH_FSSTAT");
+    if (pre != nullptr) {
+      char path[4096];
+      std::snprintf(path, sizeof(path), "%s.%d", pre, int(getpid()));
+      if (FILE *f = std::fopen(path, "a")) {
+        const char *th = std::getenv("GH_THREADS");
+        std::fprintf(f,
+                     "FSSTAT id=%zu k=%zu budget=%zu extra=%zu read=%zu "
+                     "threads=%s calls=",
+                     id, k, budget, extra, read, th != nullptr ? th : "-");
+        for (const auto &[b, c] : calls) std::fprintf(f, "%zu:%zu,", b, c);
+        std::fprintf(f, "\n");
+        std::fclose(f);
+      }
+    }
+    calls.clear();
+  }
+};
+
